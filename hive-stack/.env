HIVE_HOSTNAME_PLAIN=hive.org
HIVE_HOSTNAME=https://${HIVE_HOSTNAME_PLAIN}

HIVE_SSL_PATH=./ssl/

HIVE_API_URL=""
HIVE_CHECK_IN_URL=http://localhost:15176/

# whether to load schedule from ics file or allow building it from hive
# possible values: internal, external
HIVE_SCHEDULE_MODE=internal

HIVE_COURSE_DIRS_PATH=./dummy/Programs
HIVE_CALENDAR_DIRS_PATH=./dummy/Calendars
HIVE_TRASH_PATH=./dummy/Trash
HIVE_CORE_MEDIA_PATH=./media
HIVE_DATABASE_PATH=./db
HIVE_METRICS_PATH=./metrics
HIVE_STAFF_FS="\\\\share\\staff"
HIVE_TRASH_STAFF_FS=""

HIVE_TIME_ZONE=Asia/Jerusalem

HIVE_ACCESS_TOKEN_LIFETIME_MINUTES=10000
HIVE_REFRESH_TOKEN_LIFETIME_DAYS=10

HIVE_MAX_UPLOAD_SIZE=400 # MB. Note: files are uploaded in base64. Thus, this MUST be 4 times as much as the largest file you'd like to support.

HIVE_APPBAR_COLOR="#0DA779"
HIVE_PRIMARY_COLOR="#0da779"
HIVE_SECONDARY_COLOR="#0588B3"

HIVE_SITE_TITLE="Hive"

HIVE_PROGRAM_METADATA_SUBDIRECTORY=""
HIVE_SUBJECT_METADATA_SUBDIRECTORY=""
HIVE_MODULE_METADATA_SUBDIRECTORY=""

HIVE_PROGRAM_SUBJECTS_SUBDIRECTORY="01 - Subjects"
HIVE_SUBJECT_MODULES_SUBDIRECTORY="01 - Modules"
HIVE_MODULE_EXERCISES_SUBDIRECTORY="02 - Exercises"
HIVE_MODULE_LECTURES_SUBDIRECTORY="01 - Lectures"
HIVE_EXERCISE_FILES_SUBDIRECTORY=""

HIVE_EXERCISE_PATBAS_PATH="02 - PATBAS"
HIVE_EXERCISE_HANICH_PATH="01 - Hanich"
HIVE_EXERCISE_PREVIEW_PATH="hanich.pdf"
HIVE_EXERCISE_MD_FOLDER_PATH="00 - Preview"
HIVE_EXERCISE_MD_FILE_PATH="hanich.md"
HIVE_EXERCISE_PATBAS_PREVIEW_PATH="02 - PATBAS/patbas.pdf"
HIVE_EXERCISE_PATBAS_MD_FOLDER_PATH="02 - PATBAS/Preview"
HIVE_EXERCISE_PATBAS_MD_FILE_PATH="patbas.md"
HIVE_EXERCISE_MD_MEDIA_PATH="assets"

HIVE_DAILY_REVIEW_SUBJECT_NAME="משוב יומי"
HIVE_DAILY_REVIEW_MODULE_ORDER="00"
HIVE_DAILY_REVIEW_MODULE_NAME="פורמט"
HIVE_DAILY_REVIEW_TEMPLATE_EXERCISE_ORDER="00"
HIVE_DAILY_REVIEW_TEMPLATE_EXERCISE_NAME="פורמט"
HIVE_DAILY_REVIEW_BASE_EXERCISE_ORDER="00"
HIVE_DAILY_REVIEW_BASE_EXERCISE_NAME="בסיס"
HIVE_HOST_LINK_FORMAT="https://www.example.com/<<HOST>>"

# The logo directory must contain 3 files: logo.svg (displayed in toolbar), icon.svg (used as favicon) and notification.png (used for notifications).
# Check out the default ones in static to see required sized.
HIVE_FRONTEND_STATIC=./static/
HIVE_LOGO_FILENAME="logo.svg"

# If set to "True" and a value is given for the secret, checker registration will be enabled
HIVE_ENABLE_REGISTRATION=False
HIVE_REGISTRATION_SECRET=""

# If set to "True", users will be able to change their password
HIVE_ENABLE_PW_CHANGE=False

# If set, the "dear student" option will be checked for helps and assignments.
# The option will never be checked by default for chats, no matter the value here.
# Default is True, set to False to disable.
HIVE_DEAR_STUDENT_DEFAULT=True

# Make sure to generate nice and random data for these.
HIVE_SECRET_KEY="o()f!kz7s&6v%sdie1)k_k)5+uuq*a&ui!#w6_mae_o1-!=9_6a"
HIVE_CORE_DATABASE_PASSWORD=94i0cmt943508vu398ut0c3u490843
HIVE_DATABASE_ADMIN_PASSWORD=63a9f0ea7bb98050796b649e85481845
HIVE_GRAFANA_DATABASE_PASSWORD=63a9f0ea7bb98050796b649e85481845

HIVE_GRAFANA_DASHBOARDS_DIR=/dev/null

HIVE_AUTOCHECK_CONTAINER_TIMEOUT_SECS=600

HIVE_DOCKER_SOCKET_URL="unix://var/run/docker.sock"
HIVE_WINDOWS_DOCKER_SOCKET_URL="tcp://localhost:2735"

# It is recommended to set the workers count to (2 x $num_cores) + 1.
# Each thread is holding a connection to the database
# the database is configured to support up to 200 connection.
HIVE_CORE_WORKERS=10
HIVE_CORE_THREADS=8
HIVE_NGINX_WORKERS=auto

# LDAP authentication settings
HIVE_LDAP_AUTHENTICATION=False
HIVE_LDAP_PROVIDER="ldaps://?"
HIVE_LDAP_SEARCH_DN_PATH="ou=TopHiveUsersTreeFolder,ou=ExampleTreeFOlderBefore,dc=example,dc=dom"
HIVE_LDAP_MASTER_USER="hive_bind"
HIVE_LDAP_MASTER_PASSWORD="Password1"
HIVE_LDAP_SEARCH_FILTER="(sAMAccountName={user})"

# WDYR
HIVE_RUN_WITH_WDYR=False

HIVE_MAX_DOCKER_LOG_SIZE="2048m"

HIVE_POSTGRES_MAX_CONNECTIONS=200
HIVE_POSTGRES_SHARED_BUFFERS="256MB"

HIVE_OIDC_RSA_PRIVATE_KEY="-----BEGIN PRIVATE KEY----------END PRIVATE KEY-----"
HIVE_LOCAL_SSO_SERVICE_CLIENT_ID="hive-local-sso-service"
HIVE_LOCAL_SSO_SERVICE_CLIENT_SECRET="hive-local-sso-secret"

# OTEL
# see https://opentelemetry.io/docs/specs/otel/configuration/sdk-environment-variables/ for how to configure
# it is required to both change DISABLED to false and to set a value for EXPORTER for traces to be created + exported
OTEL_TRACES_EXPORTER=none
OTEL_SDK_DISABLED=true
